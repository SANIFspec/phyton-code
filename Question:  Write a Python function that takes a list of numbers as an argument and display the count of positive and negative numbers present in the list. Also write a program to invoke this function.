def count(a):
    p=0
    ne=0
    for i in a:
        if i>0:
            p=p+1
        elif i<0:
            ne=ne+1
    print("Positive =",p)
    print("Negative =",ne)

l=[]
n=int(input("Enter number of elements: "))
for i in range(n):
    x=int(input("Enter number: "))
    l.append(x)

count(l)
